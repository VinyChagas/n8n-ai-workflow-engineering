# n8n AI Workflow Engineering — example configuration
# Copy to .env and adjust. Never commit real secrets.

# Base URL of your n8n instance (no trailing slash required)
N8N_BASE_URL=http://localhost:5678

# Optional: full Public API base including /api/v1
# N8N_API_BASE=http://localhost:5678/api/v1

# Path to a file containing the n8n API key (single line, no quotes)
# Create an API key in n8n with scopes: workflow:list, workflow:read,
# workflow:create, workflow:update. Prefer NOT granting activate/delete/execute.
N8N_API_KEY_FILE=.secrets/n8n-api-key

# Where exported workflow JSON lives (source of truth)
WORKFLOW_DIRECTORY=./workflows

# Timestamped snapshots before create/update
BACKUP_DIRECTORY=./backups/git-backups

# Optional templates directory
TEMPLATES_DIRECTORY=./templates

# Optional: if set, status may mention docker container name (API remains primary)
# N8N_CONTAINER=n8n
# N8N_PREFER_DOCKER_CLI=false
